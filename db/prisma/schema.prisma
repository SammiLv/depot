  status        TalentRestrictionRevisionStatus @default(DRAFT)
  policyBasis   String?
  description   String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  priority      Int                             @default(100)
  revisionNote  String?
  createdById   String
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([ruleId, revisionNo])
  @@index([ruleId, status])
  @@index([effectiveFrom, effectiveTo])
}

model TalentRuleFieldDefinition {
  id              String                  @id @default(cuid())
  code            String                  @unique
  displayName     String
  source          TalentRuleFieldSource
  sourceFieldPath String
  dataType        TalentRuleFieldDataType
  enumValuesJson  String
  operatorsJson   String                  @default("[\"EQUALS\"]")
  description     String?
  ownerModule     String
  isEnabled       Boolean                 @default(true)
  isSystem        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([source, sourceFieldPath])
  @@index([source, isEnabled])
}

model TalentRestrictionRuleCondition {
  id                  String             @id @default(cuid())
  revisionId          String             @unique
  fieldDefinitionId   String
  operator            TalentRuleOperator @default(EQUALS)
  comparisonValueJson String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([fieldDefinitionId, operator])
}

model TalentRestrictionRuleOutput {
  id               String                  @id @default(cuid())
  revisionId       String
  outputType       TalentRuleOutputType
  handlingCode     String
  numericValue     Float?
  durationValue    Int?
  durationUnit     TalentRuleDurationUnit?
  effectPeriodCode String?
  parametersJson   String                  @default("{}")
  description      String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([revisionId, sortOrder])
  @@index([revisionId, outputType])
}

model PromotionRecord {
  id                String                  @id @default(cuid())
  recordNo          String                  @unique
  userId            String
  fromJobRoleId     String?
  toJobRoleId       String?
  fromJobLevelId    String?
  toJobLevelId      String?
  promotionType     String?
  outcome           PromotionOutcome         @default(SUCCESS)
  reason            String?
  effectiveDate     DateTime
  recommendationId  String?
  sourceType        TalentHistorySourceType @default(MANUAL_ENTRY)
  externalProcessNo String?
  resultStatus      TalentRecordStatus      @default(CONFIRMED)
  confirmedById     String?
  confirmedAt       DateTime?
  voidReason        String?
  createdById       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  @@index([userId, effectiveDate])
  @@index([recommendationId])
  @@index([externalProcessNo])
  @@index([resultStatus, deletedAt])
}

model SalaryAdjustmentRecord {
  id                String                  @id @default(cuid())
  recordNo          String                  @unique
  userId            String
  beforeSalary      Int?
  afterSalary       Int?
  adjustmentAmount  Int?
  adjustmentRate    Float?
  reason            String?
  effectiveDate     DateTime
  recommendationId  String?
  sourceType        TalentHistorySourceType @default(MANUAL_ENTRY)
  externalProcessNo String?
  resultStatus      TalentRecordStatus      @default(CONFIRMED)
  confirmedById     String?
  confirmedAt       DateTime?
  voidReason        String?
  createdById       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  @@index([userId, effectiveDate])
  @@index([recommendationId])
  @@index([externalProcessNo])
  @@index([resultStatus, deletedAt])
}

model RewardRecord {
  id                  String                  @id @default(cuid())
  recordNo            String                  @unique
  userId              String
  rewardLevel         TalentRewardLevel
  rewardForm          TalentRewardForm
  rewardRecipient     TalentRewardRecipient
  rewardCycle         TalentRewardCycle
  rewardPeriodYear    Int
  rewardPeriodMonth   Int?
  rewardPeriodQuarter Int?
  rewardName          String
  rewardAmount        Int
  rewardDescription   String?
  effectiveDate       DateTime
  recommendationId    String?
  sourceType          TalentHistorySourceType @default(MANUAL_ENTRY)
  externalProcessNo   String?
  resultStatus        TalentRecordStatus      @default(CONFIRMED)
  confirmedById       String?
  confirmedAt         DateTime?
  voidReason          String?
  createdById         String
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?

  @@index([userId, effectiveDate])
  @@index([recommendationId])
  @@index([externalProcessNo])
  @@index([resultStatus, deletedAt])
  @@index([rewardCycle, rewardPeriodYear, rewardPeriodMonth, rewardPeriodQuarter])
}

model EmployeeTalentProfile {
  id                                         String    @id @default(cuid())
  userId                                     String    @unique
  jobRoleId                                  String?
  entryJobLevelId                            String?
  jobLevelId                                 String?
  managerUserId                              String?
  startingSalary                             Int?
  currentSalary                              Int?
  salaryCurrency                             String    @default("CNY")
  currentContractStartAt                     DateTime?
  currentContractEndAt                       DateTime?
  currentContractSequence                    Int?
  hasTwoCReviewsInCurrentContract            Boolean?
  hasConsecutiveTwoCReviewsInCurrentContract Boolean?
  isLatestPreRenewalReviewC                  Boolean?
  hasFormalPromotionInCurrentContract        Boolean?
  decisionFactsUpdatedAt                     DateTime?
  decisionFactsUpdateNote                    String?
  profileNote                                String?
  updatedById                                String
  createdAt                                  DateTime  @default(now())
  updatedAt                                  DateTime  @updatedAt
  deletedAt                                  DateTime?

  @@index([jobRoleId])
  @@index([entryJobLevelId])
  @@index([jobLevelId])
  @@index([managerUserId])
  @@index([deletedAt])
}

model EmploymentContractTerm {
  id                String                     @id @default(cuid())
  userId            String
  contractNo        String?
  startDate         DateTime
  endDate           DateTime
  renewalSequence   Int                        @default(1)
  outcome           EmploymentContractOutcome?
  resultStatus      TalentRecordStatus         @default(DRAFT)
  recommendationId  String?
  sourceType        TalentHistorySourceType    @default(MANUAL_ENTRY)
  externalProcessNo String?
  confirmedById     String?
  confirmedAt       DateTime?
  voidReason        String?
  createdById       String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?

  @@unique([userId, startDate, renewalSequence])
  @@index([userId, endDate])
  @@index([recommendationId])
  @@index([externalProcessNo])
  @@index([resultStatus, deletedAt])
}

model SalaryCapConfig {
  id                  String              @id @default(cuid())
  departmentOrgNodeId String
  jobLevelGroupId     String
  jobLevelId          String?
  maxSalary           Int
  currency            String              @default("CNY")
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  version             Int                 @default(1)
  versionStatus       TalentVersionStatus @default(DRAFT)
  createdById         String
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  @@unique([departmentOrgNodeId, jobLevelGroupId, jobLevelId, version])
  @@index([departmentOrgNodeId, effectiveFrom])
  @@index([jobLevelGroupId])
  @@index([jobLevelId])
  @@index([versionStatus, deletedAt])
}

model TalentImportBatch {
  id                  String                  @id @default(cuid())
  importType          TalentImportType
  fileName            String
  fileSha256          String
  status              TalentImportBatchStatus @default(UPLOADED)
  year                Int?
  quarter             Int?
  departmentOrgNodeId String?
  mappingJson         String?
  summaryJson         String?
  errorFilePath       String?
  createdById         String
  confirmedById       String?
  confirmedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?

  @@index([importType, status])
  @@index([departmentOrgNodeId, createdAt])
  @@index([fileSha256])
  @@index([deletedAt])
}

model TalentImportRow {
  id                 String                @id @default(cuid())
  batchId            String
  rowNumber          Int
  rawDataJson        String
  normalizedDataJson String?
  userId             String?
  status             TalentImportRowStatus @default(PENDING)
  errorMessagesJson  String?
  importedTargetType String?
  importedTargetId   String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([userId])
  @@index([importedTargetType, importedTargetId])
}

model TalentActionLog {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  action     String
  actorId    String
  beforeJson String?
  afterJson  String?
  remark     String?
  actedAt    DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, actedAt])
  @@index([actorId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  content    String?
  targetType String?
  targetId   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([targetType, targetId])
}

model NotificationScenario {
  id              String                  @id @default(cuid())
  name            String
  description     String?
  module          String                  @default("KPI管理")
  triggerType     NotificationTriggerType
  triggerEvent    String
  scheduleConfig  Json?
  nextRunAt       DateTime?
  recipientConfig Json
  channelConfig   Json
  conditionConfig Json?
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  createdById     String?
  updatedById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  deliveryLogs NotificationDeliveryLog[]

  @@index([triggerType, isActive])
  @@index([triggerEvent, isActive])
  @@index([module, isActive])
  @@index([nextRunAt])
}

model NotificationDeliveryLog {
  id         String                     @id @default(cuid())
  scenarioId String
  eventKey   String
  userId     String
  channel    NotificationDeliveryChannel
  status     NotificationDeliveryStatus
  error      String?
  createdAt  DateTime                   @default(now())

  scenario NotificationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, eventKey, channel])
  @@index([userId])
  @@index([createdAt])
}

model NotificationGroupBot {
  id            String                       @id @default(cuid())
  name          String                       @unique
  webhookUrl    String
  securityType  DingTalkGroupBotSecurityType
  securityValue String
  createdById   String?
  updatedById   String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
}

model TodoItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  targetType  String
  targetId    String
  isDone      Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([targetType, targetId])
}
