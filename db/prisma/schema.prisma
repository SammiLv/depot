generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum RoleType {
  ADMIN
  DEPARTMENT_MANAGER
  TEAM_LEADER
  MEMBER
}

enum AnnualGoalPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PermissionScopeType {
  SYSTEM
  DEPARTMENT
}

enum OrgPermissionModuleKey {
  ANNUAL_GOAL
  KPI
  TALENT
  NOTIFICATION
  PRODUCT_MANAGEMENT
}

enum OrgPermissionAbilityKey {
  VIEW_KPI
  VIEW_KPI_TEMPLATE
  MANAGE_KPI_TEMPLATE
  TOGGLE_KPI_TEMPLATE
  INITIALIZE_KPI
  SCORE_SELF
  SCORE_LEADER
  SCORE_MANAGER
  SCORE_FINAL
  VIEW_TALENT_PROFILE
  EDIT_TALENT_PROFILE
  VIEW_TALENT_REVIEW
  MANAGE_TALENT_REVIEW
  CALIBRATE_TALENT_REVIEW
  // 历史遗留值（talent 侧已停用），保留仅为兼容历史授权数据可读
  VIEW_CAREER_MODEL
  MANAGE_CAREER_MODEL
  VIEW_BUSINESS_ASSESSMENT
  VIEW_WORK_INCIDENT
  // 业务考核/工作事故的管理能力点归 KPI 模块使用
  MANAGE_BUSINESS_ASSESSMENT
  MANAGE_WORK_INCIDENT
  VIEW_RECOMMENDATION
  MANAGE_RECOMMENDATION
  VIEW_TALENT_HISTORY
  MANAGE_TALENT_HISTORY
  VIEW_TALENT_SENSITIVE
  VIEW_TALENT_CONFIG
  MANAGE_TALENT_CONFIG
  MANAGE_NOTIFICATION_SCENARIO
  MANAGE_PRODUCT_GOAL
  MANAGE_PROJECT_AND_VALUE_TRACKING
  MANAGE_PRODUCT_TASK
}

enum NotificationTriggerType {
  EVENT
  SCHEDULE
}

enum NotificationDeliveryChannel {
  IN_APP
  DINGTALK
  DINGTALK_PERSONAL
  DINGTALK_GROUP
}

enum DingTalkGroupBotSecurityType {
  KEYWORD
  SIGN
  IP
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum OrgPermissionGrantScopeType {
  SELF
  NODE
  SUBTREE
  ALL
}

enum OrgPermissionSubjectType {
  ROLE
  USER
}

enum AnnualMetricCalculationType {
  RATIO
  BOOLEAN
  MANUAL_SCORE
}

enum ApprovalStatus {
  DRAFT
  PENDING_LEADER
  PENDING_MANAGER
  APPROVED
  REJECTED
  WITHDRAWN
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED_COMPLETED
  CLOSED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  LAUNCHED
  COMPLETED
  CLOSED
}

enum RiskStatus {
  NORMAL
  SLIGHT_DELAY
  RISK
  COMPLETED
}

enum KpiTemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum KpiStatus {
  DRAFT
  PENDING_SELF_REVIEW
  PENDING_LEADER_SCORE
  PENDING_MANAGER_SCORE
  PENDING_FINAL_REVIEW
  COMPLETED
}

enum NotificationType {
  APPROVAL_TODO
  GOAL_UPDATE
  KPI_TODO
  WORK_DELAY
  TALENT_WARNING
  SYSTEM
}

enum OrgNodeType {
  ROOT
  DEPARTMENT
  TEAM
}

enum KpiTemplateAssignmentTargetType {
  USER
  ORG_NODE
  ROLE
}

enum KpiApprovalResolverType {
  TEAM_LEADER
  DEPARTMENT_MANAGER
  ADMIN
  EXPLICIT_USER
}

enum KpiApprovalNodeMode {
  CURRENT_TEAM
  CURRENT_DEPARTMENT
  FIXED_NODE
  NONE
  ORG_NODE_OWNER
  CASCADE_TO_DEPARTMENT
}

enum TalentVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum TalentRestrictionRuleStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum TalentRestrictionRevisionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  RETIRED
  WITHDRAWN
}

enum TalentRuleCategory {
  WORK_INCIDENT
  QUARTERLY_KPI
  BUSINESS_ASSESSMENT
  TALENT_REVIEW
  EMPLOYEE_PROFILE
}

enum TalentRuleFieldSource {
  WORK_INCIDENT
  QUARTERLY_KPI
  BUSINESS_ASSESSMENT
  TALENT_REVIEW
  EMPLOYEE_PROFILE
}

enum TalentRuleFieldDataType {
  ENUM
  TRISTATE_BOOLEAN
}

enum TalentRuleOperator {
  EQUALS
}

enum TalentRuleOutputType {
  KPI_PROCESSING
  REWARD_PROCESSING
  SALARY_RESTRICTION
  PROMOTION_RESTRICTION
  ANNUAL_BONUS_PROCESSING
  TRAINING_OR_TRANSFER
  SALARY_REDUCTION
  CONTRACT_PROCESSING
}

enum TalentRuleDurationUnit {
  DAY
  MONTH
  QUARTER
  YEAR
}

enum TalentRecordStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

enum PromotionOutcome {
  SUCCESS
  REJECTED
  FAILED
}

enum TalentHistorySourceType {
  RECOMMENDATION
  COMPANY_SYSTEM
  MANUAL_IMPORT
  MANUAL_ENTRY
}

enum TalentImportType {
  EMPLOYEE_FOUNDATION
  CONTRACT_HISTORY
  PROMOTION_HISTORY
  TALENT_REVIEW
  BUSINESS_ASSESSMENT
  TALENT_HISTORY
}

enum TalentImportBatchStatus {
  UPLOADED
  MAPPED
  VALIDATED
  CONFIRMED
  FAILED
  CANCELLED
}

enum TalentImportRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  SKIPPED
}

enum TalentReviewCycleStatus {
  DRAFT
  IN_PROGRESS
  CALIBRATING
  CONFIRMED
  ARCHIVED
}

enum TalentReviewParticipantStatus {
  PENDING
  EVALUATED
  CONFIRMED
}

enum BusinessAssessmentScoringType {
  NUMERIC
  GRADE
}

enum BusinessAssessmentPassingScopeType {
  ORG_NODE
  USER
}

enum BusinessAssessmentAttemptResult {
  INITIAL_PASS
  RETEST_PASS
  FINAL_FAIL
}

enum WorkIncidentLevel {
  S
  A
  B
  C
  D
}

enum WorkIncidentStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

enum TalentRestrictionType {
  PROMOTION
  SALARY_ADJUSTMENT
  QUARTERLY_REWARD
  ANNUAL_REWARD
  TERMINATION
}

enum TalentRestrictionStatus {
  ACTIVE
  EXPIRED
  RELEASED
  VOIDED
}

enum TalentRestrictionSourceType {
  WORK_INCIDENT
  TALENT_REVIEW
  KPI
  BUSINESS_ASSESSMENT
  MANUAL
}

enum TalentRewardLevel {
  COMPANY
  DEPARTMENT
}

enum TalentRewardForm {
  COIN
  CASH
}

enum TalentRewardRecipient {
  INDIVIDUAL
  PROJECT
}

enum TalentRewardCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  OTHER
}

enum TalentDecisionType {
  PROMOTION
  CONTRACT_RENEWAL
  SALARY_ADJUSTMENT
  REWARD
  QUARTERLY_REWARD
  ANNUAL_REWARD
  DEVELOPMENT
  TERMINATION
}

enum TalentRecommendationStatus {
  DRAFT
  PROPOSED
  DEFERRED
  NOT_RECOMMENDED
  HANDED_OFF
  CLOSED
}

enum TalentDecisionCycleStatus {
  PENDING_CALCULATION
  PENDING_CONFIRMATION
  CONFIRMED
}

enum TalentDecisionEvidenceStatus {
  READY
  INCOMPLETE
}

enum CompanyFeedbackStatus {
  PENDING
  ADOPTED
  ADJUSTED_ADOPTION
  REJECTED
  DEFERRED
}

enum EmploymentContractOutcome {
  RENEWED
  NOT_RENEWED
  EXTENDED
  TERMINATED
}

model User {
  id                   String    @id @default(cuid())
  dingtalkUserId       String?   @unique
  loginName            String?   @unique
  passwordHash         String?
  passwordLoginEnabled Boolean   @default(false)
  name                 String
  email                String?
  mobile               String?
  avatarUrl            String?
  orgNodeId            String?
  roleType             RoleType  @default(MEMBER)
  title                String?
  joinedAt             DateTime?
  contractRenewAt      DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([orgNodeId])
  @@index([roleType])
}

model OrgNode {
  id             String      @id @default(cuid())
  dingtalkDeptId String?     @unique
  name           String
  nodeType       OrgNodeType
  parentId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([nodeType])
  @@index([parentId])
}

model OrgClosure {
  id           String   @id @default(cuid())
  ancestorId   String
  descendantId String
  depth        Int
  createdAt    DateTime @default(now())

  @@unique([ancestorId, descendantId])
  @@index([ancestorId])
  @@index([descendantId])
  @@index([ancestorId, depth])
  @@index([descendantId, depth])
}

model MenuPermission {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  path      String
  parentId  String?
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleMenuPermission {
  id                  String              @id @default(cuid())
  scopeType           PermissionScopeType @default(SYSTEM)
  departmentOrgNodeId String              @default("")
  roleType            RoleType
  menuPermissionId    String
  allowed             Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([scopeType, departmentOrgNodeId, roleType, menuPermissionId])
  @@index([scopeType, departmentOrgNodeId])
  @@index([menuPermissionId])
}

model AnnualGoalPermission {
  id                    String                     @id @default(cuid())
  code                  String                     @unique
  name                  String
  description           String
  sortOrder             Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  roleAnnualPermissions RoleAnnualGoalPermission[]
}

model RoleAnnualGoalPermission {
  id                     String              @id @default(cuid())
  scopeType              PermissionScopeType @default(SYSTEM)
  departmentOrgNodeId    String              @default("")
  roleType               RoleType
  annualGoalPermissionId String
  allowed                Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  annualGoalPermission AnnualGoalPermission @relation(fields: [annualGoalPermissionId], references: [id])

  @@unique([scopeType, departmentOrgNodeId, roleType, annualGoalPermissionId])
  @@index([scopeType, departmentOrgNodeId])
  @@index([annualGoalPermissionId])
}

model OrgPermissionGrant {
  id          String                      @id @default(cuid())
  moduleKey   OrgPermissionModuleKey
  abilityKey  OrgPermissionAbilityKey
  scopeType   OrgPermissionGrantScopeType
  subjectType OrgPermissionSubjectType    @default(ROLE)
  roleType    RoleType?
  userId      String?
  orgNodeId   String?
  isActive    Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([moduleKey, abilityKey, scopeType, subjectType, roleType, userId, orgNodeId])
  @@index([moduleKey, abilityKey, subjectType, roleType, isActive])
  @@index([moduleKey, abilityKey, subjectType, userId, isActive])
  @@index([subjectType, roleType])
  @@index([subjectType, userId])
  @@index([orgNodeId])
}

model ApprovalInstance {
  id                String         @id @default(cuid())
  targetType        String
  targetId          String
  title             String
  submitterId       String
  currentApproverId String?
  status            ApprovalStatus @default(DRAFT)
  submittedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([targetType, targetId])
  @@index([currentApproverId])
}

model ApprovalTask {
  id         String         @id @default(cuid())
  instanceId String
  approverId String
  stepName   String
  status     ApprovalStatus @default(DRAFT)
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([instanceId])
  @@index([approverId])
}

model AnnualGoalPlan {
  id                  String               @id @default(cuid())
  year                Int
  name                String
  description         String?
  departmentOrgNodeId String
  status              AnnualGoalPlanStatus @default(DRAFT)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  metrics AnnualGoalMetric[]

  @@index([year])
  @@index([departmentOrgNodeId, year])
  @@index([status])
  @@index([deletedAt])
}

model AnnualGoalMetricSource {
  id                String                      @id @default(cuid())
  parentMetricId    String
  metricCode        String                      @unique
  name              String
  description       String?
  targetValue       Float
  currentValue      Float                       @default(0)
  unit              String
  calculationType   AnnualMetricCalculationType @default(RATIO)
  riskStatus        RiskStatus                  @default(NORMAL)
  responsibleUserId String?
  adjustedAt        DateTime?
  progressUpdatedAt DateTime?
  createdById       String
  updatedById       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  deletedAt         DateTime?

  parentMetric AnnualGoalMetric             @relation("AnnualGoalMetricSources", fields: [parentMetricId], references: [id])
  assignments  AnnualGoalMetricAssignment[]

  @@index([parentMetricId])
  @@index([riskStatus])
  @@index([responsibleUserId])
  @@index([deletedAt])
}

model AnnualGoalMetricAssignment {
  id                String    @id @default(cuid())
  teamOrgNodeId     String
  metricId          String?
  sourceMetricId    String?
  weight            Float
  responsibleUserId String?
  sortOrder         Int       @default(0)
  createdById       String
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  metric       AnnualGoalMetric?       @relation(fields: [metricId], references: [id])
  sourceMetric AnnualGoalMetricSource? @relation(fields: [sourceMetricId], references: [id])

  @@index([teamOrgNodeId])
  @@index([metricId])
  @@index([sourceMetricId])
  @@index([responsibleUserId])
  @@index([deletedAt])
}

model AnnualGoalMetric {
  id                String                      @id @default(cuid())
  planId            String
  metricCode        String
  name              String
  description       String?
  targetValue       Float
  currentValue      Float                       @default(0)
  unit              String
  weight            Float
  calculationType   AnnualMetricCalculationType @default(RATIO)
  riskStatus        RiskStatus                  @default(NORMAL)
  responsibleUserId String?
  sortOrder         Int                         @default(0)
  adjustedAt        DateTime?
  progressUpdatedAt DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  deletedAt         DateTime?

  plan          AnnualGoalPlan               @relation(fields: [planId], references: [id])
  sourceMetrics AnnualGoalMetricSource[]     @relation("AnnualGoalMetricSources")
  assignments   AnnualGoalMetricAssignment[]

  @@index([planId])
  @@index([metricCode])
  @@index([riskStatus])
  @@index([responsibleUserId])
  @@index([deletedAt])
}

model AnnualGoalQuarterTarget {
  id                String     @id @default(cuid())
  metricId          String?
  sourceMetricId    String?
  year              Int
  quarter           Int
  targetValue       Float
  currentValue      Float      @default(0)
  weeklyIncrement   Float      @default(0)
  startDate         DateTime?
  endDate           DateTime?
  riskStatus        RiskStatus @default(NORMAL)
  adjustedAt        DateTime?
  progressUpdatedAt DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  @@index([metricId])
  @@index([sourceMetricId])
  @@index([year, quarter])
  @@index([riskStatus])
}

model AnnualGoalProgress {
  id              String   @id @default(cuid())
  metricId        String
  sourceMetricId  String?
  quarterTargetId String?
  updaterId       String
  progressDate    DateTime
  completedValue  Float
  cumulativeValue Float
  summary         String?
  riskNote        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([metricId])
  @@index([sourceMetricId])
  @@index([quarterTargetId])
  @@index([updaterId])
}

model Project {
  id                String        @id @default(cuid())
  title             String
  description       String?
  expectedOutcome   String?
  startQuarter      String?
  endQuarter        String?
  ownerId           String
  orgNodeId         String?
  status            ProjectStatus @default(NOT_STARTED)
  launchedAt        DateTime?
  completedAt       DateTime?
  workloadPersonDay Float?
  otherCost         String?
  actualValue       String?
  valueJudgement    String?
  valueTrackStatus  String?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  quarterlyWorks QuarterlyWork[]
  productGoalLinks ProjectProductGoal[]

  @@index([ownerId])
  @@index([orgNodeId])
  @@index([status])
}

model ProjectProductGoal {
  id            String   @id @default(cuid())
  projectId     String
  productGoalId String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productGoal ProductGoal @relation(fields: [productGoalId], references: [id], onDelete: Cascade)

  @@unique([projectId, productGoalId])
  @@index([projectId])
  @@index([productGoalId])
}

model ProductGoal {
  id              String        @id @default(cuid())
  title           String
  year            Int
  description     String?
  expectedOutcome String?
  ownerId         String
  orgNodeId       String?
  status          ProjectStatus @default(NOT_STARTED)
  createdById     String
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  projectLinks ProjectProductGoal[]

  @@index([year])
  @@index([ownerId])
  @@index([orgNodeId])
  @@index([status])
}

model QuarterlyWork {
  id              String         @id @default(cuid())
  projectId       String
  year            Int
  quarter         Int
  startMonth      Int?
  endMonth        Int?
  title           String
  description     String?
  workType        String?
  ownerId         String
  orgNodeId       String?
  status          WorkStatus     @default(NOT_STARTED)
  approvalStatus  ApprovalStatus @default(DRAFT)
  expectedOutcome String?
  startDate       DateTime?
  endDate         DateTime?
  createdById     String
  completedAt     DateTime?
  taskResult      String?
  executionSummary String?
  taskDescription String?
  workloadPersonDay Float?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([year, quarter])
  @@index([ownerId])
  @@index([orgNodeId])
}

model MonthlyWorkPlan {
  id              String     @id @default(cuid())
  quarterlyWorkId String
  year            Int
  month           Int
  title           String
  description     String?
  status          WorkStatus @default(NOT_STARTED)
  expectedOutcome String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([quarterlyWorkId])
}

model WeeklyWorkUpdate {
  id                String     @id @default(cuid())
  quarterlyWorkId   String
  monthlyWorkPlanId String?
  updaterId         String
  updateDate        DateTime
  status            WorkStatus
  summary           String
  nextStep          String?
  riskNote          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([quarterlyWorkId])
  @@index([monthlyWorkPlanId])
  @@index([updaterId])
}

model RequirementValueTrack {
  id                   String    @id @default(cuid())
  projectId            String
  trackingResult       String
  followUpOptimization String?
  trackedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([projectId])
  @@index([trackedAt])
}

model OperationLog {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  targetTitle String
  action      String
  operatorId  String
  remark      String?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model KpiTemplate {
  id                  String            @id @default(cuid())
  templateKey         String
  departmentOrgNodeId String
  name                String
  description         String?
  status              KpiTemplateStatus @default(DRAFT)
  version             Int               @default(1)
  isLatest            Boolean           @default(true)
  isActive            Boolean           @default(true)
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  reviewComment       String?
  createdById         String
  updatedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@unique([templateKey, version])
  @@index([departmentOrgNodeId, status, isActive])
  @@index([templateKey, isLatest])
  @@index([status, isActive])
  @@index([deletedAt])
  @@index([updatedById])
}

model KpiTemplateAssignment {
  id                   String                          @id @default(cuid())
  templateId           String
  targetType           KpiTemplateAssignmentTargetType
  targetUserId         String?
  targetOrgNodeId      String?
  targetRoleType       RoleType?
  effectiveFromYear    Int?
  effectiveFromQuarter Int?
  effectiveToYear      Int?
  effectiveToQuarter   Int?
  isActive             Boolean                         @default(true)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([templateId])
  @@index([targetType, targetUserId])
  @@index([targetType, targetOrgNodeId])
  @@index([targetType, targetRoleType])
  @@index([isActive])
}

model KpiApprovalPolicy {
  id                  String              @id @default(cuid())
  scopeType           PermissionScopeType @default(SYSTEM)
  departmentOrgNodeId String              @default("")
  name                String
  description         String?
  isActive            Boolean             @default(true)
  activeScopeKey      String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([scopeType, departmentOrgNodeId, name])
  @@index([scopeType, departmentOrgNodeId, isActive])
}

model KpiApprovalPolicyScope {
  id        String   @id @default(cuid())
  policyId  String
  orgNodeId String
  createdAt DateTime @default(now())

  @@unique([policyId, orgNodeId])
  @@index([policyId])
  @@index([orgNodeId])
}

model KpiApprovalPolicyStep {
  id                      String                  @id @default(cuid())
  policyId                String
  stepOrder               Int
  label                   String
  nodeMode                KpiApprovalNodeMode?
  approvalOrgNodeId       String?
  ancestorDepth           Int?
  resolverType            KpiApprovalResolverType
  resolverUserId          String?
  skipIfSelf              Boolean                 @default(true)
  skipIfDuplicateApprover Boolean                 @default(true)
  allowSkipWhenNoApprover Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([policyId, stepOrder])
  @@index([policyId])
  @@index([approvalOrgNodeId])
  @@index([resolverType])
  @@index([resolverUserId])
}

model KpiApprovalPolicyStepOrgNode {
  id           String   @id @default(cuid())
  policyStepId String
  orgNodeId    String
  createdAt    DateTime @default(now())

  @@unique([policyStepId, orgNodeId])
  @@index([policyStepId])
  @@index([orgNodeId])
}

model KpiTemplateItem {
  id              String   @id @default(cuid())
  templateId      String
  name            String
  description     String?
  score           Float    @default(0)
  weight          Float
  scoringStandard String?
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([templateId])
}

model PersonalKpi {
  id                                String               @id @default(cuid())
  year                              Int
  quarter                           Int
  userId                            String
  orgNodeId                         String?
  templateId                        String?
  templateVersion                   Int?
  approvalPolicyId                  String?
  approvalPolicyName                String?
  approvalPolicyScopeType           PermissionScopeType?
  approvalPolicyDepartmentOrgNodeId String?
  approvalPolicyScopeOrgNodeId      String?
