generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum RoleType {
  ADMIN
  DEPARTMENT_MANAGER
  TEAM_LEADER
  MEMBER
}

enum AnnualGoalPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PermissionScopeType {
  SYSTEM
  DEPARTMENT
}

enum OrgPermissionModuleKey {
  ANNUAL_GOAL
  KPI
  NOTIFICATION
  PRODUCT_MANAGEMENT
}

enum OrgPermissionAbilityKey {
  VIEW_KPI
  VIEW_KPI_TEMPLATE
  MANAGE_KPI_TEMPLATE
  TOGGLE_KPI_TEMPLATE
  INITIALIZE_KPI
  SCORE_SELF
  SCORE_LEADER
  SCORE_MANAGER
  SCORE_FINAL
  MANAGE_NOTIFICATION_SCENARIO
  MANAGE_PRODUCT_GOAL
  MANAGE_PROJECT_AND_VALUE_TRACKING
  MANAGE_PRODUCT_TASK
}

enum NotificationTriggerType {
  EVENT
  SCHEDULE
}

enum NotificationDeliveryChannel {
  IN_APP
  DINGTALK
  DINGTALK_PERSONAL
  DINGTALK_GROUP
}

enum DingTalkGroupBotSecurityType {
  KEYWORD
  SIGN
  IP
}

enum NotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum OrgPermissionGrantScopeType {
  SELF
  NODE
  SUBTREE
  ALL
}

enum OrgPermissionSubjectType {
  ROLE
  USER
}

enum AnnualMetricCalculationType {
  RATIO
  BOOLEAN
  MANUAL_SCORE
}

enum ApprovalStatus {
  DRAFT
  PENDING_LEADER
  PENDING_MANAGER
  APPROVED
  REJECTED
  WITHDRAWN
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED_COMPLETED
  CLOSED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  LAUNCHED
  COMPLETED
  CLOSED
}

enum RiskStatus {
  NORMAL
  SLIGHT_DELAY
  RISK
  COMPLETED
}

enum KpiTemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum KpiStatus {
  DRAFT
  PENDING_SELF_REVIEW
  PENDING_LEADER_SCORE
  PENDING_MANAGER_SCORE
  PENDING_FINAL_REVIEW
  COMPLETED
}

enum NotificationType {
  APPROVAL_TODO
  GOAL_UPDATE
  KPI_TODO
  WORK_DELAY
  TALENT_WARNING
  SYSTEM
}

enum OrgNodeType {
  ROOT
  DEPARTMENT
  TEAM
}

enum KpiTemplateAssignmentTargetType {
  USER
  ORG_NODE
  ROLE
}

enum KpiApprovalResolverType {
  TEAM_LEADER
  DEPARTMENT_MANAGER
  ADMIN
  EXPLICIT_USER
}

enum KpiApprovalNodeMode {
  CURRENT_TEAM
  CURRENT_DEPARTMENT
  FIXED_NODE
  NONE
  ORG_NODE_OWNER
  CASCADE_TO_DEPARTMENT
}

model User {
  id                   String    @id @default(cuid())
  dingtalkUserId       String?   @unique
  loginName            String?   @unique
  passwordHash         String?
  passwordLoginEnabled Boolean   @default(false)
  name                 String
  email                String?
  mobile               String?
  avatarUrl            String?
  orgNodeId            String?
  roleType             RoleType  @default(MEMBER)
  title                String?
  joinedAt             DateTime?
  contractRenewAt      DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([orgNodeId])
  @@index([roleType])
}

model OrgNode {
  id             String      @id @default(cuid())
  dingtalkDeptId String?     @unique
  name           String
  nodeType       OrgNodeType
  parentId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([nodeType])
  @@index([parentId])
}

model OrgClosure {
  id           String   @id @default(cuid())
  ancestorId   String
  descendantId String
  depth        Int
  createdAt    DateTime @default(now())

  @@unique([ancestorId, descendantId])
  @@index([ancestorId])
  @@index([descendantId])
  @@index([ancestorId, depth])
  @@index([descendantId, depth])
}

model MenuPermission {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  path      String
  parentId  String?
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleMenuPermission {
  id                  String              @id @default(cuid())
  scopeType           PermissionScopeType @default(SYSTEM)
  departmentOrgNodeId String              @default("")
  roleType            RoleType
  menuPermissionId    String
  allowed             Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([scopeType, departmentOrgNodeId, roleType, menuPermissionId])
  @@index([scopeType, departmentOrgNodeId])
  @@index([menuPermissionId])
}

model AnnualGoalPermission {
  id                    String                     @id @default(cuid())
  code                  String                     @unique
  name                  String
  description           String
  sortOrder             Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  roleAnnualPermissions RoleAnnualGoalPermission[]
}

model RoleAnnualGoalPermission {
  id                     String              @id @default(cuid())
  scopeType              PermissionScopeType @default(SYSTEM)
  departmentOrgNodeId    String              @default("")
  roleType               RoleType
  annualGoalPermissionId String
  allowed                Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  annualGoalPermission AnnualGoalPermission @relation(fields: [annualGoalPermissionId], references: [id])

  @@unique([scopeType, departmentOrgNodeId, roleType, annualGoalPermissionId])
  @@index([scopeType, departmentOrgNodeId])
  @@index([annualGoalPermissionId])
}

model OrgPermissionGrant {
  id          String                      @id @default(cuid())
  moduleKey   OrgPermissionModuleKey
  abilityKey  OrgPermissionAbilityKey
  scopeType   OrgPermissionGrantScopeType
  subjectType OrgPermissionSubjectType    @default(ROLE)
  roleType    RoleType?
  userId      String?
  orgNodeId   String?
  isActive    Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([moduleKey, abilityKey, scopeType, subjectType, roleType, userId, orgNodeId])
  @@index([moduleKey, abilityKey, subjectType, roleType, isActive])
  @@index([moduleKey, abilityKey, subjectType, userId, isActive])
  @@index([subjectType, roleType])
  @@index([subjectType, userId])
  @@index([orgNodeId])
}

model ApprovalInstance {
  id                String         @id @default(cuid())
  targetType        String
  targetId          String
  title             String
  submitterId       String
  currentApproverId String?
  status            ApprovalStatus @default(DRAFT)
  submittedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([targetType, targetId])
  @@index([currentApproverId])
}

model ApprovalTask {
  id         String         @id @default(cuid())
  instanceId String
  approverId String
  stepName   String
  status     ApprovalStatus @default(DRAFT)
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([instanceId])
  @@index([approverId])
}

model AnnualGoalPlan {
  id                  String               @id @default(cuid())
  year                Int
  name                String
  description         String?
  departmentOrgNodeId String
  status              AnnualGoalPlanStatus @default(DRAFT)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  metrics AnnualGoalMetric[]

  @@index([year])
  @@index([departmentOrgNodeId, year])
  @@index([status])
  @@index([deletedAt])
}

model AnnualGoalMetricSource {
  id                String                      @id @default(cuid())
  parentMetricId    String
  metricCode        String                      @unique
  name              String
  description       String?
  targetValue       Float
  currentValue      Float                       @default(0)
  unit              String
  calculationType   AnnualMetricCalculationType @default(RATIO)
  riskStatus        RiskStatus                  @default(NORMAL)
  responsibleUserId String?
  adjustedAt        DateTime?
  progressUpdatedAt DateTime?
  createdById       String
  updatedById       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  deletedAt         DateTime?

  parentMetric AnnualGoalMetric             @relation("AnnualGoalMetricSources", fields: [parentMetricId], references: [id])
  assignments  AnnualGoalMetricAssignment[]

  @@index([parentMetricId])
  @@index([riskStatus])
  @@index([responsibleUserId])
  @@index([deletedAt])
}

model AnnualGoalMetricAssignment {
  id                String    @id @default(cuid())
  teamOrgNodeId     String
  metricId          String?
  sourceMetricId    String?
  weight            Float
  responsibleUserId String?
  sortOrder         Int       @default(0)
  createdById       String
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  metric       AnnualGoalMetric?       @relation(fields: [metricId], references: [id])
  sourceMetric AnnualGoalMetricSource? @relation(fields: [sourceMetricId], references: [id])

  @@index([teamOrgNodeId])
  @@index([metricId])
  @@index([sourceMetricId])
  @@index([responsibleUserId])
  @@index([deletedAt])
}

model AnnualGoalMetric {
  id                String                      @id @default(cuid())
  planId            String
  metricCode        String
  name              String
  description       String?
  targetValue       Float
  currentValue      Float                       @default(0)
  unit              String
  weight            Float
  calculationType   AnnualMetricCalculationType @default(RATIO)
  riskStatus        RiskStatus                  @default(NORMAL)
  responsibleUserId String?
  sortOrder         Int                         @default(0)
  adjustedAt        DateTime?
  progressUpdatedAt DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  deletedAt         DateTime?

  plan          AnnualGoalPlan               @relation(fields: [planId], references: [id])
  sourceMetrics AnnualGoalMetricSource[]     @relation("AnnualGoalMetricSources")
  assignments   AnnualGoalMetricAssignment[]

  @@index([planId])
  @@index([metricCode])
  @@index([riskStatus])
  @@index([responsibleUserId])
  @@index([deletedAt])
}

model AnnualGoalQuarterTarget {
  id                String     @id @default(cuid())
  metricId          String?
  sourceMetricId    String?
  year              Int
  quarter           Int
  targetValue       Float
  currentValue      Float      @default(0)
  weeklyIncrement   Float      @default(0)
  startDate         DateTime?
  endDate           DateTime?
  riskStatus        RiskStatus @default(NORMAL)
  adjustedAt        DateTime?
  progressUpdatedAt DateTime?
  createdById       String?
  updatedById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  @@index([metricId])
  @@index([sourceMetricId])
  @@index([year, quarter])
  @@index([riskStatus])
}

model AnnualGoalProgress {
  id              String   @id @default(cuid())
  metricId        String
  sourceMetricId  String?
  quarterTargetId String?
  updaterId       String
  progressDate    DateTime
  completedValue  Float
  cumulativeValue Float
  summary         String?
  riskNote        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([metricId])
  @@index([sourceMetricId])
  @@index([quarterTargetId])
  @@index([updaterId])
}

model Project {
  id                String        @id @default(cuid())
  title             String
  description       String?
  expectedOutcome   String?
  startQuarter      String?
  endQuarter        String?
  ownerId           String
  orgNodeId         String?
  status            ProjectStatus @default(NOT_STARTED)
  launchedAt        DateTime?
  completedAt       DateTime?
  workloadPersonDay Float?
  otherCost         String?
  actualValue       String?
  valueJudgement    String?
  valueTrackStatus  String?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  quarterlyWorks QuarterlyWork[]
  productGoalLinks ProjectProductGoal[]

  @@index([ownerId])
  @@index([orgNodeId])
  @@index([status])
}

model ProjectProductGoal {
  id            String   @id @default(cuid())
  projectId     String
  productGoalId String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productGoal ProductGoal @relation(fields: [productGoalId], references: [id], onDelete: Cascade)

  @@unique([projectId, productGoalId])
  @@index([projectId])
  @@index([productGoalId])
}

model ProductGoal {
  id              String        @id @default(cuid())
  title           String
  year            Int
  description     String?
  expectedOutcome String?
  ownerId         String
  orgNodeId       String?
  status          ProjectStatus @default(NOT_STARTED)
  createdById     String
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  projectLinks ProjectProductGoal[]

  @@index([year])
  @@index([ownerId])
  @@index([orgNodeId])
  @@index([status])
}

model QuarterlyWork {
  id              String         @id @default(cuid())
  projectId       String
  year            Int
  quarter         Int
  startMonth      Int?
  endMonth        Int?
  title           String
  description     String?
  workType        String?
  ownerId         String
  orgNodeId       String?
  status          WorkStatus     @default(NOT_STARTED)
  approvalStatus  ApprovalStatus @default(DRAFT)
  expectedOutcome String?
  startDate       DateTime?
  endDate         DateTime?
  createdById     String
  completedAt     DateTime?
  taskResult      String?
  executionSummary String?
  taskDescription String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([year, quarter])
  @@index([ownerId])
  @@index([orgNodeId])
}

model MonthlyWorkPlan {
  id              String     @id @default(cuid())
  quarterlyWorkId String
  year            Int
  month           Int
  title           String
  description     String?
  status          WorkStatus @default(NOT_STARTED)
  expectedOutcome String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([quarterlyWorkId])
}

model WeeklyWorkUpdate {
  id                String     @id @default(cuid())
  quarterlyWorkId   String
  monthlyWorkPlanId String?
  updaterId         String
  updateDate        DateTime
  status            WorkStatus
  summary           String
  nextStep          String?
  riskNote          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([quarterlyWorkId])
  @@index([monthlyWorkPlanId])
  @@index([updaterId])
}

model RequirementValueTrack {
  id                    String    @id @default(cuid())
  projectId             String
  trackingResult        String
  followUpOptimization  String?
  trackedAt             DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@index([projectId])
  @@index([trackedAt])
}

model OperationLog {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  targetTitle String
  action      String
  operatorId  String
  remark      String?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model KpiTemplate {
  id                  String            @id @default(cuid())
  templateKey         String
  departmentOrgNodeId String
  name                String
  description         String?
  status              KpiTemplateStatus @default(DRAFT)
  version             Int               @default(1)
  isLatest            Boolean           @default(true)
  isActive            Boolean           @default(true)
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  reviewComment       String?
  createdById         String
  updatedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@unique([templateKey, version])
  @@index([departmentOrgNodeId, status, isActive])
  @@index([templateKey, isLatest])
  @@index([status, isActive])
  @@index([deletedAt])
  @@index([updatedById])
}

model KpiTemplateAssignment {
  id                   String                          @id @default(cuid())
  templateId           String
  targetType           KpiTemplateAssignmentTargetType
  targetUserId         String?
  targetOrgNodeId      String?
  targetRoleType       RoleType?
  effectiveFromYear    Int?
  effectiveFromQuarter Int?
  effectiveToYear      Int?
  effectiveToQuarter   Int?
  isActive             Boolean                         @default(true)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([templateId])
  @@index([targetType, targetUserId])
  @@index([targetType, targetOrgNodeId])
  @@index([targetType, targetRoleType])
  @@index([isActive])
}

model KpiApprovalPolicy {
  id                  String              @id @default(cuid())
  scopeType           PermissionScopeType @default(SYSTEM)
  departmentOrgNodeId String              @default("")
  name                String
  description         String?
  isActive            Boolean             @default(true)
  activeScopeKey      String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([scopeType, departmentOrgNodeId, name])
  @@index([scopeType, departmentOrgNodeId, isActive])
}

model KpiApprovalPolicyScope {
  id        String   @id @default(cuid())
  policyId  String
  orgNodeId String
  createdAt DateTime @default(now())

  @@unique([policyId, orgNodeId])
  @@index([policyId])
  @@index([orgNodeId])
}

model KpiApprovalPolicyStep {
  id                      String                  @id @default(cuid())
  policyId                String
  stepOrder               Int
  label                   String
  nodeMode                KpiApprovalNodeMode?
  approvalOrgNodeId       String?
  ancestorDepth           Int?
  resolverType            KpiApprovalResolverType
  resolverUserId          String?
  skipIfSelf              Boolean                 @default(true)
  skipIfDuplicateApprover Boolean                 @default(true)
  allowSkipWhenNoApprover Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([policyId, stepOrder])
  @@index([policyId])
  @@index([approvalOrgNodeId])
  @@index([resolverType])
  @@index([resolverUserId])
}

model KpiApprovalPolicyStepOrgNode {
  id           String   @id @default(cuid())
  policyStepId String
  orgNodeId    String
  createdAt    DateTime @default(now())

  @@unique([policyStepId, orgNodeId])
  @@index([policyStepId])
  @@index([orgNodeId])
}

model KpiTemplateItem {
  id              String   @id @default(cuid())
  templateId      String
  name            String
  description     String?
  score           Float    @default(0)
  weight          Float
  scoringStandard String?
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([templateId])
}

model PersonalKpi {
  id                                String               @id @default(cuid())
  year                              Int
  quarter                           Int
  userId                            String
  orgNodeId                         String?
  templateId                        String?
  templateVersion                   Int?
  approvalPolicyId                  String?
  approvalPolicyName                String?
  approvalPolicyScopeType           PermissionScopeType?
  approvalPolicyDepartmentOrgNodeId String?
  approvalPolicyScopeOrgNodeId      String?
  status                            KpiStatus            @default(DRAFT)
  selfScore                         Float?
  leaderScore                       Float?
  managerScore                      Float?
  finalScore                        Float?
  selfComment                       String?
  leaderComment                     String?
  managerComment                    String?
  submittedAt                       DateTime?
  completedAt                       DateTime?
  initializedAt                     DateTime?
  initializedById                   String?
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt
  deletedAt                         DateTime?

  @@unique([year, quarter, userId])
  @@index([year, quarter])
  @@index([userId])
  @@index([orgNodeId])
  @@index([approvalPolicyId])
}

model PersonalKpiItem {
  id                     String   @id @default(cuid())
  personalKpiId          String
  sourceTemplateItemId   String?
  relatedAnnualMetricId  String?
  relatedQuarterTargetId String?
  relatedWorkId          String?
  name                   String
  description            String?
  score                  Float    @default(0)
  weight                 Float
  target                 String?
  scoringStandard        String?
  selfScore              Float?
  leaderScore            Float?
  managerScore           Float?
  finalScore             Float?
  selfComment            String?
  leaderComment          String?
  managerComment         String?
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([personalKpiId])
  @@index([relatedAnnualMetricId])
  @@index([relatedQuarterTargetId])
  @@index([relatedWorkId])
}

model PersonalKpiItemStepScore {
  id                String   @id @default(cuid())
  personalKpiItemId String
  approvalStepId    String
  score             Float    @default(0)
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([personalKpiItemId, approvalStepId])
  @@index([approvalStepId])
  @@index([personalKpiItemId])
}

model PersonalKpiActionLog {
  id            String   @id @default(cuid())
  personalKpiId String
  actorId       String
  action        String
  remark        String?
  actedAt       DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([personalKpiId, actedAt])
  @@index([actorId])
}

model PersonalKpiApprovalStep {
  id             String                   @id @default(cuid())
  personalKpiId  String
  policyStepId   String?
  stepOrder      Int
  stageKey       String
  stepLabel      String?
  nodeMode       KpiApprovalNodeMode?
  configuredOrgNodeId String?
  ancestorDepth  Int?
  resolverType   KpiApprovalResolverType?
  resolverUserId String?
  orgNodeId      String?
  approverId     String
  status         String                   @default("PENDING")
  comment        String?
  actedAt        DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())

  @@index([personalKpiId, stepOrder])
  @@index([policyStepId])
  @@index([configuredOrgNodeId])
  @@index([approverId, status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  content    String?
  targetType String?
  targetId   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([targetType, targetId])
}

model NotificationScenario {
  id              String                  @id @default(cuid())
  name            String
  description     String?
  module          String                  @default("KPI管理")
  triggerType     NotificationTriggerType
  triggerEvent    String
  scheduleConfig  Json?
  nextRunAt       DateTime?
  recipientConfig Json
  channelConfig   Json
  conditionConfig Json?
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  createdById     String?
  updatedById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  deliveryLogs NotificationDeliveryLog[]

  @@index([triggerType, isActive])
  @@index([triggerEvent, isActive])
  @@index([module, isActive])
  @@index([nextRunAt])
}

model NotificationDeliveryLog {
  id         String                     @id @default(cuid())
  scenarioId String
  eventKey   String
  userId     String
  channel    NotificationDeliveryChannel
  status     NotificationDeliveryStatus
  error      String?
  createdAt  DateTime                   @default(now())

  scenario NotificationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, eventKey, channel])
  @@index([userId])
  @@index([createdAt])
}

model NotificationGroupBot {
  id            String                       @id @default(cuid())
  name          String                       @unique
  webhookUrl    String
  securityType  DingTalkGroupBotSecurityType
  securityValue String
  createdById   String?
  updatedById   String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
}

model TodoItem {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  targetType  String
  targetId    String
  isDone      Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([targetType, targetId])
}
