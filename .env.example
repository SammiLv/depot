# ===== 基础（本地开发默认值，复制为 .env 即可用）=====
# SQLite 数据库文件位置；留空或 file:./dev.db 时实际落在 db/dev.db（见 db/prisma.config.ts）
DATABASE_URL="file:./dev.db"
# 会话加密密钥，本地随便填；生产必须换成随机长字符串
NEXTAUTH_SECRET="local-dev-secret"
# 本机访问地址（生成通知链接、登录回调时使用）
APP_URL="http://localhost:3000"
# Next.js dev 模式下允许的跨域来源（逗号分隔，next.config.ts 读取）
DEV_ALLOWED_ORIGINS="localhost:3000,127.0.0.1:3000"
# 本地 http 必须 false；https 部署才设 true
SESSION_COOKIE_SECURE="false"

# ===== 钉钉（可选；不配置则扫码登录/通知机器人不可用，密码登录不受影响）=====
DINGTALK_APP_KEY="your-dingtalk-app-key"
# DINGTALK_APP_ID="your-dingtalk-app-id"
# DINGTALK_GATEWAY_BASE="https://api.dingtalk.com"
# 钉钉通知总开关，本地默认关闭
DINGTALK_NOTIFY_ENABLED="false"

# ===== 通知调度器（可选；本地一般关闭，dev:home 脚本里会单独打开）=====
NOTIFICATION_SCHEDULER_ENABLED="false"
