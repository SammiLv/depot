{
  "name": "department-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:office": "HOSTNAME=0.0.0.0 PORT=80 APP_URL=http://depot.rj-info.com DEV_ALLOWED_ORIGINS=depot.rj-info.com next dev -H 0.0.0.0 -p 80",
    "dev:home": "HOSTNAME=0.0.0.0 PORT=3000 APP_URL=http://localhost:3000 DEV_ALLOWED_ORIGINS=localhost:3000,127.0.0.1:3000 next dev -H 0.0.0.0 -p 3000",
    "dev:quarterly": "HOSTNAME=0.0.0.0 PORT=3001 APP_URL=http://localhost:3001 DEV_ALLOWED_ORIGINS=localhost:3001,127.0.0.1:3001 next dev -H 0.0.0.0 -p 3001",
    "dev:annual": "HOSTNAME=0.0.0.0 PORT=3002 APP_URL=http://localhost:3002 DEV_ALLOWED_ORIGINS=localhost:3002,127.0.0.1:3002 next dev -H 0.0.0.0 -p 3002",
    "dev:platform": "HOSTNAME=0.0.0.0 PORT=3003 APP_URL=http://localhost:3003 DEV_ALLOWED_ORIGINS=localhost:3003,127.0.0.1:3003 next dev -H 0.0.0.0 -p 3003",
    "dev:kpi": "HOSTNAME=0.0.0.0 PORT=3004 APP_URL=http://localhost:3004 DEV_ALLOWED_ORIGINS=localhost:3004,127.0.0.1:3004 next dev -H 0.0.0.0 -p 3004",
    "build": "next build",
    "start": "next start",
    "start:office": "HOSTNAME=0.0.0.0 PORT=80 APP_URL=http://depot.rj-info.com next start -H 0.0.0.0 -p 80",
    "start:home": "HOSTNAME=0.0.0.0 PORT=3000 APP_URL=http://localhost:3000 next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "test:kpi": "node --import tsx --test src/server/kpi/approval-policy.test.ts src/server/kpi/approval-policy-admin.test.ts src/server/kpi/approval-snapshot.test.ts src/server/kpi/approval-workflow.test.ts",
    "test:kpi:integration": "bash scripts/test-kpi-approval-integration.sh",
    "test:kpi:all": "npm run test:kpi && npm run test:kpi:integration && npm run test:kpi:migration && npm run test:kpi:production-scripts",
    "test:kpi:migration": "bash scripts/test-kpi-production-migration.sh",
    "test:kpi:production-scripts": "bash scripts/test-kpi-production-orchestration.sh && node scripts/test-kpi-production-powershell.mjs",
    "kpi:migration:preflight": "node --import tsx scripts/preflight-kpi-production.ts",
    "kpi:migration:run": "node --import tsx scripts/migrate-kpi-production.ts",
    "kpi:migration:align": "node --import tsx scripts/align-kpi-migration-history.ts",
    "kpi:migration:verify": "node --import tsx scripts/verify-kpi-production.ts",
    "kpi:production:run": "bash scripts/kpi-production/09-run-all.sh",
    "kpi:production:rollback": "bash scripts/kpi-production/08-rollback.sh",
    "kpi:production:windows:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kpi-production/09-run-all.ps1",
    "kpi:production:windows:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kpi-production/08-rollback.ps1",
    "prisma:generate": "prisma generate --schema db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema db/prisma/schema.prisma",
    "seed": "tsx db/prisma/seed.ts",
    "set-admin-password": "tsx scripts/set-admin-password.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
