# Copy this file outside the Git repository, then replace every placeholder.
# Do not put passwords, tokens, or other secrets in this file.

# Absolute path to the production SQLite database.
KPI_PROD_DB="/absolute/path/to/prod.db"

# Existing absolute directory used to store migration backups and reports.
KPI_BACKUP_ROOT="/absolute/path/to/backups"

# PM2 process name for this application. The process must run:
# npm run start:office
KPI_PM2_SERVICE_NAME="department-management"

# Public production URL without a trailing slash.
KPI_APP_URL="http://depot.rj-info.com:80"

# Optional command executed before prisma generate and next build.
# Leave empty when dependencies are prepared by the release system.
KPI_INSTALL_COMMAND=""

# Optional command used by 08-rollback.sh to restore the previous application
# release before the old database is put back into service.
# Example for a symlink-based deployment:
# KPI_ROLLBACK_CODE_COMMAND="ln -sfn /srv/releases/previous /srv/current"
KPI_ROLLBACK_CODE_COMMAND=""
